# Copy to .env on the VPS and fill in. docker-compose.yml reads this file for
# both interpolation and the backend's environment. Spec §3.1 is the source of
# truth for the backend half; apps/backend/src/config/env.ts enforces it.
#
# Keep every value free of `$`: compose expands it in this file.
# `.env` is gitignored. Never commit real keys.

# --- Host and Traefik. You supply these. ---------------------------------
# Hostname Traefik routes to the API. DNS for it must point at this box.
API_HOST=api.example.com
# Name of the docker network the running Traefik already watches.
TRAEFIK_NETWORK=traefik
# Traefik certresolver name, from Traefik's own static config. Traefik owns TLS.
CERT_RESOLVER=letsencrypt

# --- Postgres. You choose these; compose builds DATABASE_URL from them. ---
POSTGRES_USER=hexvault
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hexvault
# DATABASE_URL is set by docker-compose.yml to point at the postgres service.
# Only set it here when running the backend outside compose:
# DATABASE_URL=postgresql://hexvault:hexvault@localhost:5432/hexvault

# --- Chain. You supply these. --------------------------------------------
# Helius devnet HTTPS url. The websocket url is derived from it.
RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# The deployed program. Must match declare_id! and Anchor.toml after step 1.
PROGRAM_ID=LFk9ba6QXuM9oYRRNGGPxMGzfo13X3DAr8ghSPz72C6
# Base58 secret key of the Operator's hot key. `solana-keygen new`, then
# airdrop devnet SOL to it. It signs every crank; it never holds user funds.
OPERATOR_KEYPAIR=
# Optional. Base58 pubkey of the pool admin (parameters, unpause, principal).
# No key for it lives here. Empty means the loaded keypair is the admin too.
ADMIN_ADDRESS=
# Optional. Base58 secret key of the Sparring player's wallet, which buys one
# Position per Round. `sparring-setup` prints one when this is empty; leaving
# it empty keeps the Sparring player off. See the runbook.
SPARRING_KEYPAIR=

# Optional. Secret for POST /access/invites (header x-admin-key), so invite
# codes can be minted without VPS access. Empty turns the route off.
# Generate with `openssl rand -hex 32`.
INVITE_ADMIN_KEY=

# --- Produced by bootstrap (ticket 09). Paste its output over these. ------
# The pool. Bump it to start a clean demo, then re-run bootstrap.
POOL_ID=1
# The mint the pool takes deposits in: the test mint bootstrap creates on
# devnet, real USDC on mainnet. Empty until bootstrap has run once. The old
# name HEXUSDC_MINT is still read, with a warning at boot.
ACCEPTED_MINT=

# --- Pool tuning. Defaults from spec §7; the backend falls back to these. --
# SOL below which /status and /healthz flag the operator as running out of fees.
OPERATOR_SOL_WARN=0.5
# Cap, in microlamports per compute unit, on the priority fee the operator
# attaches to land transactions during congestion (ticket 10).
PRIORITY_FEE_MAX_MICROLAMPORTS=50000
# Faucet grant per request, in hexUSDC base units. 1000000000 = 1000 hexUSDC.
FAUCET_AMOUNT=1000000000
# Seconds one wallet must wait between faucet grants.
FAUCET_INTERVAL_SECONDS=3600

# --- create_pool defaults (bootstrap only; ADR 0011). --------------------
# Base yield's APR in basis points. 488 with daily compounding is ~5% APY.
BASE_RATE_BPS=488
# Tickets credited per USDC spent in buy_tickets.
TICKETS_PER_USDC=10
# Share of total_principal, in basis points, an operator grant_tickets call
# may credit pool-wide per epoch.
BONUS_CAP_BPS=500

# --- Referrals (ticket 07/08). --------------------------------------------
# Seconds a referee's Principal must stay at or above 50 USDC, without a
# break, before the referral qualifies for the daily bonus. Shorten on
# devnet to see a referral qualify sooner.
REFERRAL_QUALIFY_SECONDS=604800

# --- API. ----------------------------------------------------------------
# Origins allowed to call the API, comma-separated. Set after step 3, then restart backend.
CORS_ORIGIN=https://your-app.vercel.app,http://localhost:5173
# The port the backend listens on. compose pins this to 8080 to match the
# Traefik service label; changing it here has no effect inside compose.
PORT=8080
