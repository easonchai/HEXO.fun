# HexVault local stack. Copy to .env for docker compose variable expansion.

# Postgres for the indexer and API. Inside the compose network the host is `db`;
# from the host machine (e.g. for running vitest) use localhost.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hexvault

# Solana RPC. Localnet validator via `--profile chain`, or your own devnet RPC.
# host.docker.internal reaches a validator running on the host from containers.
RPC_URL=http://host.docker.internal:8899

PROGRAM_ID=6aDFSdwXESHF7UXJRCkHogNtUTbDPajmLupsfvzTSGvB

# Web app: Privy app id enables the Privy wallet layer — set VITE_PRIVY_APP_ID
# in apps/web/.env.local (gitignored); without it the app falls back to
# standard wallets. ORAO VRF network state for
# `hexvault initialize --vrf-state` (devnet):
# 5ER1oENnV4srxYdAynUfRzWeQCPQaqMiAp4VqyMbSqnK
VITE_PRIVY_APP_ID=

# API listen port.
PORT=8081

# Optional: verbosity for both services (info | debug).
LOG_LEVEL=info

# Optional: how often the indexer runs reconciliation checks (ms).
RECONCILE_INTERVAL_MS=60000
