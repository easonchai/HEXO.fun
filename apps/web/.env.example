# apps/web environment. Copy to .env.local and fill in.
# Every variable is optional; the defaults below target a local validator.

# Solana RPC HTTP endpoint. A localhost/127.0.0.1 host is what enables the
# dev burner wallet (see src/dev-burner.ts). Default: http://127.0.0.1:8899
VITE_RPC_URL=http://127.0.0.1:8899

# NestJS read API (apps/backend). Default: http://127.0.0.1:8080
VITE_API_URL=http://127.0.0.1:8080

# Overrides the program id baked into src/idl/hex_vault.json. Set it when the
# program is redeployed without re-running `pnpm --filter @hexvault/web sync-idl`.
VITE_PROGRAM_ID=LFk9ba6QXuM9oYRRNGGPxMGzfo13X3DAr8ghSPz72C6

# The pool this build talks to. Default: 1
VITE_POOL_ID=1

# Privy application id. Publishable by design. Set to "" or "off" to skip
# Privy and use standard injected Solana wallets instead.
VITE_PRIVY_APP_ID=
