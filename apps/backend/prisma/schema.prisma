// Mirrors the on-chain account layouts in programs/hex_vault/src/state.rs.
// spec.md §3.2. On-chain u64 -> BigInt, u128 -> Decimal(40, 0). Addresses and
// pubkeys are base58 strings; the API layer serializes BigInt/Decimal as
// decimal strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pool {
  address             String  @id
  poolId              BigInt
  /// Squads multisig on mainnet: set_params, unpause, admin_withdraw, set_operator.
  admin               String
  /// The hot crank key the backend signs with.
  operator            String
  /// Half of a two-step admin handover; null when no handover is open.
  pendingAdmin        String?
  mint                String
  epochSeconds        BigInt
  epochAnchor         BigInt
  roundSeconds        BigInt
  closeBuffer         BigInt
  minDeposit          BigInt
  paused              Boolean
  currentEpochId      BigInt
  currentEpochEndsAt  BigInt
  previousEpochEndsAt BigInt
  totalPrincipal      BigInt
  /// Requested withdrawals the principal vault still owes.
  pendingWithdrawals  BigInt
  /// An epoch closing under this rolls over instead of paying a token prize.
  minJackpot          BigInt
  carryPot            BigInt
  houseCutBps         Int
  /// Base yield's APR on time-weighted Principal, in basis points.
  baseRateBps         Int
  /// USDC in the principal vault earmarked for Base yield, not yet credited.
  yieldBudget         BigInt
  /// Tickets credited per USDC spent in `buy_tickets`.
  ticketsPerUsdc      Int
  /// Share of totalPrincipal, in basis points, an operator grant_tickets
  /// call may credit pool-wide per epoch.
  bonusCapBps         Int
  /// The epoch bonusGranted is counted against.
  bonusEpoch          BigInt
  /// Tickets an operator grant_tickets call has credited pool-wide so far
  /// in bonusEpoch.
  bonusGranted        BigInt
  /// Lets a future upgrade migrate an old account lazily (ADR 0013).
  version             Int
  /// Admin-only and irreversible: stops every inflow, the game and the
  /// draw, and lets withdrawals skip the epoch lock.
  shutdown            Boolean
  updatedSlot         BigInt
}

model Epoch {
  id                BigInt   @id
  startsAt          BigInt
  endsAt            BigInt
  status            Int
  registeredWeight  Decimal  @db.Decimal(40, 0)
  registeredCount   Int
  jackpotAmount     BigInt
  target            Decimal  @db.Decimal(40, 0)
  winner            String?
}

model Round {
  id          BigInt  @id
  epochId     BigInt
  startsAt    BigInt
  endsAt      BigInt
  status      Int
  pot         BigInt
  houseCut    BigInt
  winningTile Int?
  tileTotals  Json
  /// `close_round` reclaimed this Round's rent and closed the account.
  /// `roundRow` never carries this field, so mirroring the still-open
  /// account never resets it back to false once the RoundClosed event has
  /// set it; the row keeps its last mirrored state instead of being
  /// deleted or blanked (ops-and-envs ticket 08).
  closed      Boolean @default(false)
}

model Player {
  owner        String  @id
  principal    BigInt
  entries      BigInt
  weightAcc    Decimal @db.Decimal(40, 0)
  lastUpdate   BigInt
  epochId      BigInt
  frozenWeight Decimal @db.Decimal(40, 0)
  frozenEpoch  BigInt
  regEpoch     BigInt
  regStart     Decimal @db.Decimal(40, 0)
  regEnd       Decimal @db.Decimal(40, 0)
  isHouse      Boolean
  /// Requested but not yet paid; `process_withdraw` pays it and zeroes it.
  pendingWithdraw BigInt
  /// The epoch the request was made in. It pays once the pool has moved past it.
  pendingEpoch    BigInt
  /// Σ principal × seconds within epochId. Mirrors weightAcc with Principal
  /// in place of Entries.
  principalAcc       Decimal @db.Decimal(40, 0)
  /// Final principal-seconds for frozenEpoch, set alongside frozenWeight.
  frozenPrincipalAcc Decimal @db.Decimal(40, 0)
  /// The epoch Base yield was last credited for.
  yieldEpoch         BigInt
  /// The epoch boughtAmount is counted against.
  boughtEpoch        BigInt
  /// USDC spent in buy_tickets so far in boughtEpoch, capped at principal.
  boughtAmount       BigInt
  /// The epoch bonusGranted is counted against.
  bonusEpoch         BigInt
  /// Tickets an operator grant_tickets call has credited this Player so far
  /// in bonusEpoch.
  bonusGranted       BigInt
}

model Position {
  address      String  @id
  owner        String
  roundId      BigInt
  tiles        BigInt
  stakePerTile BigInt
}

// Finalized program events, decoded from `Program data:` logs.
model Event {
  slot      BigInt
  signature String
  index     Int
  name      String
  data      Json
  blockTime BigInt?

  @@id([slot, signature, index])
}

// Single row (id = 1): the indexer's signature-catch-up cursor. `updatedAt`
// is unix seconds of the last successful sync, so GET /status can report a
// cursor age without guessing from the newest event's block time.
model Cursor {
  id            Int     @id
  lastSignature String?
  lastSlot      BigInt?
  updatedAt     BigInt?
}

model FaucetClaim {
  owner       String @id
  lastClaimAt BigInt
}

// Invite codes gate the private beta (docs/plan/hexo-referrals ticket 06).
// ownerWallet is indexed, not unique: the admin CLI may hand one wallet
// several codes, and the indexer only checks "does this wallet have one yet".
model InviteCode {
  code        String  @id
  ownerWallet String?
  maxUses     Int
  uses        Int     @default(0)
  createdAt   BigInt

  @@index([ownerWallet])
}

// No relation to InviteCode (or Referral.code): deleting a code is how one
// gets revoked, and that must leave redemptions already made intact.
model InviteRedemption {
  wallet     String @id
  code       String
  redeemedAt BigInt
}

// Referral binding and qualification (docs/plan/hexo-referrals ticket 07).
// Written once, in the same transaction as the redeem that creates it
// (access.controller.ts); referrer, code and boundAt are never touched again.
model Referral {
  referee  String @id
  referrer String
  code     String
  boundAt  BigInt
  /// Unix seconds Principal last crossed up through 50 USDC; null while
  /// below it (or never having been above). Driven by the indexer off
  /// Deposited, WithdrawRequested, YieldCredited and compounded JackpotPaid.
  aboveSince BigInt?
  /// The referee's Principal as of the last Principal-changing event the
  /// indexer applied here. Not the live Player.principal: see referral.ts's
  /// ReferralQualificationState for why this is tracked independently.
  principal  BigInt  @default(0)

  @@index([referrer])
}

// One referrer's computed daily bonus for one epoch (docs/plan/hexo-referrals
// ticket 08), written before the operator sends grant_tickets. No @id: the
// unique index is the natural key, and createMany({ skipDuplicates: true })
// uses it to make writing a referrer's row for an epoch idempotent across
// restarts. txSig fills in once the batch it was sent in confirms; a null
// txSig on a row this epoch is a grant still owed.
model ReferralGrant {
  epochId        BigInt
  referrer       String
  amount         BigInt
  qualifiedCount Int
  rateBps        Int
  txSig          String?

  @@unique([epochId, referrer])
}

// Single row (id = 1): what the operator last did, for GET /status.
model OperatorState {
  id               Int     @id
  lastTickAt       BigInt?
  /** Wall-clock unix seconds of the scheduler's next planned wake, so the
   *  web status summary can read a long deadline-driven sleep as live
   *  instead of stale (ticket 03, spec.md "Operator status learns about
   *  sleeping"). */
  nextWakeAt       BigInt?
  lastAction       String?
  lastError        String?
  registeredCount  Int?
  registeredTotal  Int?
  /** How much the principal vault was short of the withdrawals due on the
   *  last tick that tried to pay them. 0 when the last try covered them all,
   *  null before any tick has looked. */
  withdrawShortfall BigInt?
}
