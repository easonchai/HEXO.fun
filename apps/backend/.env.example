# spec.md §3.1. Copy to .env and fill in.
DATABASE_URL=postgresql://hexvault:hexvault@localhost:5432/hexvault
RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
PROGRAM_ID=LFk9ba6QXuM9oYRRNGGPxMGzfo13X3DAr8ghSPz72C6
POOL_ID=1
OPERATOR_KEYPAIR=
# Optional. Base58 pubkey of the pool admin; no key for it lives here.
ADMIN_ADDRESS=
# The mint the pool takes deposits in. The old name HEXUSDC_MINT still works.
ACCEPTED_MINT=
# SOL below which /status flags the operator as running out of fees.
OPERATOR_SOL_WARN=0.3
FAUCET_AMOUNT=1000000000
FAUCET_INTERVAL_SECONDS=3600
CORS_ORIGIN=http://localhost:5173
PORT=8080
# Optional. Base58 secret of the Sparring player's wallet; `sparring-setup`
# prints one when this is empty. Absent means the Sparring player does not play.
SPARRING_KEYPAIR=
