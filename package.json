{
  "name": "hexvault",
  "version": "0.1.0",
  "private": true,
  "description": "Solana active prize-linked savings protocol prototype",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
